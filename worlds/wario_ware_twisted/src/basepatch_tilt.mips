.gba

.open "WarioWare - Twisted! (USA).gba", "wario_twisted_tilt.gba", 0x08000000


; Disables unlocking games
.org 0x0800086C
.thumb
    bx lr
.org 0x0801824E
.thumb
    nop
.org 0x08018314
.thumb
    b 0x08018320
.org 0x080184B2
.thumb
    ; premature return, skips setting default high scores
    mov r0, #0
    pop {r4}
    pop {r1}
    bx r1
.org 0x08000754
.thumb
    ; disables unlocking wario's stage
    nop

.org 0x08016078
.thumb
    ; allows seeing tower games every time
    nop

; Disables unlocking microgames
.org 0x0800094E
.thumb
    mov r0, #0
    bx lr
.org 0x080008D6
.thumb
    mov r0, #0
    bx lr

; Automagically unlock things in Spindex
.org 0x08016998
.thumb
    nop 
;    b 0x0801699C

; Allow accessing every submenu in Spindex
.org 0x08016BFC
.thumb
    nop 
;    b 0x0801699C


; Auto skip cutscenes
.org 0x0800A58E
.thumb
    ldr r0, =skip_cutscenes+1
    mov lr, pc
    bx r0

.pool

    
.org 0x08ECE000
.thumb
    skip_cutscenes:
        ldr r1, =0x03003B34
        ldrb r1, [r1, #0x00]    ; not a cutscene
        cmp r1, #0x17
        beq ending_cutscene
        cmp r1, #0x01
        beq intro_cutscene
    return_no_skip:
        ldr r1, =0x0800A612+1
        bx r1

    intro_cutscene:
    ending_cutscene:
        ldr r0, =0x0813EE28     ; pointer to credits?
        ldr r1, =0x03003B30     ; compare it with the loaded pointer
        ldr r1, [r1, #0x00]
        cmp r1, r0
        bne return_skip

    credits:
        ldr r0, =0x03003B10
        ldrb r0, [r0, #0x06]
        lsr r0, r0, #0x07
        cmp r0, #0x07
        beq return_no_skip
    return_check_buttons:
        ldr r1, =0x0800A598+1
        bx r1

    return_skip:
        ldr r1, =0x0800A5A4+1
        bx r1

.pool

.close

